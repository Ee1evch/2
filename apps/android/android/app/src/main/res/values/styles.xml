<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#FF4433</item>
        <item name="colorPrimaryDark">#09090A</item>
        <item name="colorAccent">#FF4433</item>
        <item name="android:windowBackground">@color/dotlink_bg</item>
        <item name="android:statusBarColor">@color/dotlink_bg</item>
        <item name="android:navigationBarColor">@color/dotlink_bg</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/dotlink_bg</item>
        <item name="android:statusBarColor">@color/dotlink_bg</item>
        <item name="android:navigationBarColor">@color/dotlink_bg</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>